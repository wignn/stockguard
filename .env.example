# =====================================================================
# StokGuard - Environment Configuration Template
# =====================================================================
# Salin berkas ini ke `.env` sebelum menjalankan `docker compose up -d`:
#   cp .env.example .env

# Port publik
WEB_PORT=3000
API_PORT=8000

# Cookie keamanan (set true jika berjalan di domain publik dengan HTTPS/SSL)
STOKGUARD_SECURE_COOKIES=false

# ---------------------------------------------------------------------
# Opsi 1: Setup Akun Pemilik Otomatis Saat Boot Pertama
# ---------------------------------------------------------------------
AUTO_SETUP=false
BUSINESS_NAME=Toko Berkah Mandiri
ADMIN_USERNAME=pemilik
ADMIN_PASSWORD=RahasiaMinimal12Karakter!

# ---------------------------------------------------------------------
# Opsi 2: Seed Data Demonstrasi Lengkap Otomatis Saat Boot Pertama
# ---------------------------------------------------------------------
SEED_DEMO=false
DEMO_OWNER_USERNAME=demo-pemilik
DEMO_STAFF_USERNAME=demo-staf
DEMO_OWNER_PASSWORD=PasswordPemilikDemo123!
DEMO_STAFF_PASSWORD=PasswordStafDemo123!
